# ===== 服务器部署环境变量模板 =====
# 用法：复制到服务器部署目录的 backend/.env 并填入真实值。
# 注意：真实密钥只存在服务器上，禁止提交进仓库。

# 应用
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
STRICT_PRODUCTION_CONFIG=true

# 数据库（compose 内网地址，服务名 db）
DATABASE_URL=postgresql+psycopg2://taskpilot:CHANGE_ME_DB_PASSWORD@db:5432/taskpilot

# Redis（compose 内网地址，服务名 redis）
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# 允许跨域的前端来源（逗号分隔；整套入口为 nginx 容器的 8090 端口）
CORS_ORIGINS=http://your-server-host:8090

# JWT（改成随机长字符串）
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
SECRET_ENCRYPTION_KEY=CHANGE_ME_DEDICATED_DATA_KEY

# 模型网关（OpenAI 兼容端点；公共示例为 DashScope）
AI_GATEWAY_API_KEY=CHANGE_ME_GATEWAY_KEY
AI_GATEWAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# SMTP 邮件（可选；SMTP_HOST 留空时验证码打印到后端日志，mock 模式）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=auto
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Workspace 沙箱（Agent 命令在独立 Docker 容器中执行，与项目环境隔离）
# 镜像构建：docker compose build skill-sandbox（见 docker/Dockerfile.skill）
WORKSPACE_BACKEND=docker
WORKSPACE_DOCKER_IMAGE=taskpilot-skill:latest
# 逗号分隔的额外 pip 包，构建期注入沙箱网关 venv（一般留空，包已烘焙进镜像）
WORKSPACE_DOCKER_EXTRA_PIP=
# 后端容器内 outputs 对应的宿主机真实路径（沙箱兄弟容器 bind mount 源，
# 必须与 docker-compose.yml 中 outputs 卷的宿主侧路径一致）
WORKSPACE_HOST_OUTPUT_DIR=/srv/taskpilot/data/backend/outputs
