# Compose substitution + backend runtime configuration for the production host.
REGISTRY_PREFIX=registry.example.com/taskpilot
# App and sandbox image tags are independent. IMAGE_TAG is only a legacy
# fallback for deployments that have not yet migrated to split tags.
BACKEND_IMAGE_TAG=CHANGE_ME_GIT_SHA
FRONTEND_IMAGE_TAG=CHANGE_ME_GIT_SHA
SKILL_IMAGE_TAG=CHANGE_ME_SKILL_SHA
IMAGE_TAG=
TASKPILOT_DATA_ROOT=/srv/taskpilot/data
TASKPILOT_BACKEND_CONTAINER=taskpilot-prod-backend
TASKPILOT_FRONTEND_CONTAINER=taskpilot-prod-frontend
TASKPILOT_DB_CONTAINER=taskpilot-prod-db
TASKPILOT_REDIS_CONTAINER=taskpilot-prod-redis
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD

APP_ENV=production
STRICT_PRODUCTION_CONFIG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://your-server-host:8090
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
SECRET_ENCRYPTION_KEY=CHANGE_ME_DEDICATED_DATA_KEY

# 模型网关（OpenAI 兼容端点）；公共示例为 DashScope
AI_GATEWAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_GATEWAY_API_KEY=CHANGE_ME_GATEWAY_KEY
MODEL_NAME=qwen-plus
AVAILABLE_MODELS=qwen-turbo,qwen-plus,qwen-max

# 单轮回复的加权 token 预算（input×1 + output×2，按 reply 清零，不是会话级上限）。
# 不填即用代码默认值：工具助手(dialog) 1000000、数据分析师(task) 2000000。
TOKEN_BUDGET_DIALOG=1000000
TOKEN_BUDGET_TASK=2000000

WORKSPACE_DOCKER_ENV_PASSTHROUGH=
WORKSPACE_DOCKER_EXTRA_PIP=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=auto
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=
